# 服务
HOST=0.0.0.0
PORT=2254
LOG_LEVEL=info
# 卡密在日志里只显示带盐指纹；固定盐后重启前后仍可关联同一张卡（留空则每次启动随机）
# LOG_SALT=
# PUBLIC_ORIGIN=https://example.com
# TRUST_PROXY=loopback

# 上游网址：只能写在 .env，必须是 HTTPS
# ChatGPT_Web 可用逗号写多个，第一个为主站，其余兜底
ChatGPT_Web=https://your-chatgpt-site.example
# Team_Web 必须以 / 结尾；留空则 Team 兑换显示“暂未开放”
Team_Web=https://your-team-site.example/team-redeem/

# 超时（毫秒）
UPSTREAM_TIMEOUT_MS=25000
TEAM_REDEEM_TIMEOUT_MS=15000

# 并发限制（可选）
# UPSTREAM_CONCURRENCY=8
# UPSTREAM_QUEUE=100
# UPSTREAM_QUEUE_WAIT_MS=8000

# 网络代理（可选）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost

# 其他（可选）
# SERVICE_DIAGNOSTICS=1
BYBUY_TEST_CARD=
