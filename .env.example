# 前后端共用一个端口。Node.js 24+。
HOST=0.0.0.0
PORT=2254
UPSTREAM_ORIGIN=https://primary.example,https://backup.example
UPSTREAM_TIMEOUT_MS=25000
# 日志级别：info（默认）/ debug / warn / error / silent。
LOG_LEVEL=info
# 可选：只记录接口阶段、HTTP 状态和耗时，不记录请求体、卡密或 Session。
# SERVICE_DIAGNOSTICS=1
# 部署到域名后启用，用于同源请求检查。
# PUBLIC_ORIGIN=https://buy.bingyun.vip
# 由本机反向代理（Caddy / Nginx）转发时使用 loopback。
# TRUST_PROXY=loopback
# 可选：服务器需要通过受信任代理访问外网时配置。ByBuy.sh 会把当前终端已有的
# HTTP_PROXY / HTTPS_PROXY / NO_PROXY 安全写入 .env，但不会在日志中打印其值。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost
# 仅本地联调脚本使用，不会发送给浏览器或写入构建产物。
BYBUY_TEST_CARD=

# ---- 多人同时使用相关的配置 ----
# UPSTREAM_ORIGIN 可以写多个域名，用逗号分隔；第一个是主站，后面的作为兜底。
#   可配置主、备两个 HTTPS origin；主站不可用时会自动切到备用站。
# UPSTREAM_ORIGIN=https://primary.example,https://backup.example
#
# TRUST_PROXY：反代（Caddy / Nginx）后面**必须**打开。
#   不开的话 req.ip 永远是反代的地址，所有人共用一个限流桶 ——
#   一个人点快了，其他所有人都会收到「操作较频繁」。
#   本机反代用 loopback。
# TRUST_PROXY=loopback
#
# 上游并发闸门（单进程内存态，多副本部署时每个副本各有一份，要相应调小）：
#   UPSTREAM_CONCURRENCY   同时最多几个请求打到上游
#   UPSTREAM_QUEUE         超出的最多排多少个
#   UPSTREAM_QUEUE_WAIT_MS 排队超过多久直接返回「当前使用人数较多」
# UPSTREAM_CONCURRENCY=8
# UPSTREAM_QUEUE=100
# UPSTREAM_QUEUE_WAIT_MS=8000
