{
  "name": "bybuy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.5.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --use-env-proxy server/index.mjs --dev",
    "build": "tsc --noEmit && vite build && node scripts/check-browser-output.mjs",
    "check:browser-output": "node scripts/check-browser-output.mjs",
    "start": "node --env-file-if-exists=.env --use-env-proxy server/index.mjs",
    "test": "LOG_LEVEL=silent node --test tests/*.test.mjs",
    "test:live": "node --env-file-if-exists=.env scripts/probe.mjs",
    "test:browser-leak": "python3 tests/browser_leak.py",
    "test:ui": "python3 tests/browser.py"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.10.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
